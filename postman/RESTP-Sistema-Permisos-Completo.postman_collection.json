									"});",
									"",
									"pm.test(\"Supervisor tiene múltiples roles\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.roles).to.be.an('array');",
									"    pm.expect(jsonData.roles.length).to.be.greaterThan(1);",
									"    console.log('Roles del supervisor:', jsonData.roles.map(r => r.nombre));",
									"});",
									"",
									"pm.test(\"Tiene rol principal definido\", function () {",
									"    const jsonData = pm.response.json();",
									"    const rolPrincipal = jsonData.roles.find(r => r.esRolPrincipal);",
									"    pm.expect(rolPrincipal).to.not.be.undefined;",
									"    pm.environment.set('supervisor_rol_principal', rolPrincipal.idRol);",
									"});"
								],
								"type": "text/javascript"
