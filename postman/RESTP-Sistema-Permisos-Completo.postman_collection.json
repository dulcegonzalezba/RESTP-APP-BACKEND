		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script global que se ejecuta antes de cada request",
					"",
					"// Verificar que las variables de entorno estén configuradas",
					"if (!pm.environment.get('base_url')) {",
					"    console.warn('⚠️ Variable base_url no configurada');",
					"}",
					"",
					"// Log del request que se va a ejecutar",
					"console.log(`🔄 Ejecutando: ${pm.request.method} ${pm.request.url}`);",
					"",
					"// Timestamp para medir performance",
					"pm.globals.set('request_start_time', Date.now());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script global que se ejecuta después de cada request",
					"",
					"// Medir tiempo total de request",
					"const startTime = pm.globals.get('request_start_time');",
					"if (startTime) {",
					"    const totalTime = Date.now() - startTime;",
					"    console.log(`⏱️ Tiempo total: ${totalTime}ms`);",
					"}",
					"",
					"// Log del resultado",
					"console.log(`✅ Status: ${pm.response.status} ${pm.response.reason()}`);",
					"",
					"// Test global: verificar que el response sea JSON válido cuando sea exitoso",
					"if (pm.response.status >= 200 && pm.response.status < 300) {",
					"    pm.test('Response es JSON válido', function () {",
					"        pm.response.to.be.json;",
					"    });",
					"}",
					"",
					"// Test global: verificar headers de seguridad básicos",
					"pm.test('Headers de respuesta presentes', function () {",
					"    pm.expect(pm.response.headers.get('Content-Type')).to.exist;",
					"});"
				]
			}
		}
