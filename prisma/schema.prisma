generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["global_sistema", "rest_test"]
}

model Empresa {
  id             String                @id @default(cuid()) @map("id_empresa") @db.VarChar(26)
  codigo         String                @unique @db.VarChar(20)
  nombre         String                @db.VarChar(200)
  tipo           TipoEmpresa
  configuracion  Json                  @default("{}")
  activa         Boolean               @default(true)
  fechaCreacion  DateTime              @default(now()) @map("fecha_creacion")
  subscripciones EmpresaSubscripcion[]
  usuarios       Usuario[]

  @@index([tipo, activa])
  @@map("empresas")
  @@schema("global_sistema")
}

model Horario {
  id                     String       @id @default(cuid()) @map("id_horario") @db.VarChar(26)
  codigo                 String       @unique @db.VarChar(20)
  nombre                 String       @db.VarChar(100)
  descripcion            String?      @db.VarChar(200)
  horarioSemanal         Json         @map("horario_semanal")
  tipoHorario            TipoHorario? @map("tipo_horario")
  aplicaATipo            AplicaTipo?  @map("aplica_a_tipo")
  activo                 Boolean      @default(true)
  fechaCreacion          DateTime     @default(now()) @map("fecha_creacion")
  usuarioRolesEspecifico UsuarioRol[] @relation("HorarioEspecifico")
  usuariosBase           Usuario[]    @relation("HorarioBase")

  @@index([codigo])
  @@index([tipoHorario, aplicaATipo])
  @@map("horarios")
  @@schema("global_sistema")
}

model Modulo {
  id                 String           @id @default(cuid()) @map("id_modulo") @db.VarChar(26)
  codigo             String           @unique @db.VarChar(20)
  nombre             String           @db.VarChar(100)
  descripcion        String?          @db.VarChar(200)
  icono              String?          @db.VarChar(50)
  categoria          String?          @db.VarChar(50)
  ordenVisualizacion Int              @default(1) @map("orden_visualizacion")
  activo             Boolean          @default(true)
  licenciaModulos    LicenciaModulo[]
  acciones           ModuloAccion[]
  planModulos        PlanModulo[]

  @@index([categoria, ordenVisualizacion])
  @@map("modulos")
  @@schema("global_sistema")
}

model ModuloAccion {
  id                   String          @id @default(cuid()) @map("id_modulo_accion") @db.VarChar(26)
  idModulo             String          @map("id_modulo") @db.VarChar(26)
  codigo               String          @db.VarChar(20)
  nombre               String          @db.VarChar(100)
  descripcion          String?         @db.VarChar(200)
  requiereAutorizacion Boolean         @default(false) @map("requiere_autorizacion")
  nivelCriticidad      NivelCriticidad @default(normal) @map("nivel_criticidad")
  ordenVisualizacion   Int             @default(1) @map("orden_visualizacion")
  activo               Boolean         @default(true)
  modulo               Modulo          @relation(fields: [idModulo], references: [id])
  logActividades       LogActividad[]
  permisos             Permiso[]

  @@unique([idModulo, codigo])
  @@index([nivelCriticidad])
  @@map("modulo_acciones")
  @@schema("global_sistema")
}

model Plan {
  id               String                @id @default(cuid()) @map("id_plan") @db.VarChar(26)
  codigo           String                @unique @db.VarChar(20)
  nombre           String                @db.VarChar(100)
  descripcion      String?               @db.VarChar(200)
  precio           Decimal               @default(0.00) @db.Decimal(10, 2)
  tipoOrganizacion String?               @map("tipo_organizacion") @db.VarChar(30)
  activo           Boolean               @default(true)
  subscripciones   EmpresaSubscripcion[]
  modulos          PlanModulo[]

  @@map("planes")
  @@schema("global_sistema")
}

model PlanModulo {
  id           String  @id @default(cuid()) @map("id_plan_modulo") @db.VarChar(26)
  idPlan       String  @map("id_plan") @db.VarChar(26)
  idModulo     String  @map("id_modulo") @db.VarChar(26)
  incluido     Boolean @default(true)
  limitaciones Json    @default("{}")
  modulo       Modulo  @relation(fields: [idModulo], references: [id])
  plan         Plan    @relation(fields: [idPlan], references: [id])

  @@map("plan_modulos")
  @@schema("global_sistema")
}

model EmpresaSubscripcion {
  id                    String    @id @default(cuid()) @map("id_subscripcion") @db.VarChar(26)
  idEmpresa             String    @map("id_empresa") @db.VarChar(26)
  idPlan                String    @map("id_plan") @db.VarChar(26)
  fechaInicio           DateTime  @map("fecha_inicio") @db.Date
  fechaVencimiento      DateTime? @map("fecha_vencimiento") @db.Date
  configuracionEspecial Json      @default("{}") @map("configuracion_especial")
  activa                Boolean   @default(true)
  empresa               Empresa   @relation(fields: [idEmpresa], references: [id])
  plan                  Plan      @relation(fields: [idPlan], references: [id])

  @@map("empresa_subscripciones")
  @@schema("global_sistema")
}

model Licencia {
  id                   String           @id @default(cuid()) @map("id_licencia") @db.VarChar(26)
  codigo               String           @unique @db.VarChar(20)
  nombre               String           @db.VarChar(100)
  descripcion          String?          @db.VarChar(200)
  precio               Decimal          @default(0.00) @db.Decimal(10, 2)
  limitacionesGlobales Json             @default("{}") @map("limitaciones_globales")
  activo               Boolean          @default(true)
  fechaCreacion        DateTime         @default(now()) @map("fecha_creacion")
  modulos              LicenciaModulo[]

  @@map("licencias")
  @@schema("global_sistema")
}

model LicenciaModulo {
  id           String   @id @default(cuid()) @map("id_licencia_modulo") @db.VarChar(26)
  idLicencia   String   @map("id_licencia") @db.VarChar(26)
  idModulo     String   @map("id_modulo") @db.VarChar(26)
  incluido     Boolean  @default(true)
  limitaciones Json     @default("{}")
  licencia     Licencia @relation(fields: [idLicencia], references: [id])
  modulo       Modulo   @relation(fields: [idModulo], references: [id])

  @@unique([idLicencia, idModulo])
  @@map("licencia_modulos")
  @@schema("global_sistema")
}

model Usuario {
  id                      String               @id @default(cuid()) @map("id_usuario") @db.VarChar(26)
  idEmpresa               String               @map("id_empresa") @db.VarChar(26)
  numeroEmpleado          String?              @unique @map("numero_empleado") @db.VarChar(20)
  nombreUsuario           String               @unique @map("nombre_usuario") @db.VarChar(50)
  email                   String               @unique @db.VarChar(100)
  passwordHash            String               @map("password_hash") @db.VarChar(255)
  nombre                  String               @db.VarChar(100)
  apellidoPaterno         String               @map("apellido_paterno") @db.VarChar(100)
  apellidoMaterno         String?              @map("apellido_materno") @db.VarChar(100)
  fechaNacimiento         DateTime?            @map("fecha_nacimiento") @db.Date
  telefono                String?              @db.VarChar(15)
  sucursal                String               @db.VarChar(50)
  area                    String?              @db.VarChar(50)
  puesto                  String?              @db.VarChar(100)
  nivel                   String?              @db.VarChar(20)
  fechaIngreso            DateTime?            @map("fecha_ingreso") @db.Date
  idHorarioBase           String               @map("id_horario_base") @db.VarChar(26)
  idRolPorDefecto         String?              @map("id_rol_por_defecto") @db.VarChar(26)
  turnosDisponibles       Json                 @default("[]") @map("turnos_disponibles")
  accesoEfectivo          Boolean              @default(false) @map("acceso_efectivo")
  nivelAccesoCaja         Int                  @default(0) @map("nivel_acceso_caja")
  certificaciones         Json                 @default("{}") @map("certificaciones")
  version                 BigInt               @default(1)
  ultimaModificacion      DateTime             @default(now()) @map("ultima_modificacion")
  sincronizado            Boolean              @default(true)
  activo                  Boolean              @default(true)
  fechaCreacion           DateTime             @default(now()) @map("fecha_creacion")
  colaSincronizacion      ColaSincronizacion[]
  logActividades          LogActividad[]
  sesiones                Sesion[]
  autorizacionesOtorgadas UsuarioRol[]         @relation("AutorizadoPor")
  usuarioRoles            UsuarioRol[]
  empresa                 Empresa              @relation(fields: [idEmpresa], references: [id])
  horarioBase             Horario              @relation("HorarioBase", fields: [idHorarioBase], references: [id])
  rolPorDefecto           Rol?                 @relation("RolPorDefecto", fields: [idRolPorDefecto], references: [id])

  @@index([sucursal, area, nivel])
  @@index([version, ultimaModificacion])
  @@index([idRolPorDefecto])
  @@map("usuarios")
  @@schema("rest_test")
}

model Rol {
  id                   String         @id @default(cuid()) @map("id_rol") @db.VarChar(26)
  codigo               String         @unique @db.VarChar(20)
  nombre               String         @db.VarChar(100)
  descripcion          String?        @db.VarChar(200)
  categoria            String?        @db.VarChar(50)
  area                 String?        @db.VarChar(50)
  nivel                String?        @db.VarChar(20)
  prioridadOrden       Int            @default(1) @map("prioridad_orden")
  esRolPrincipal       Boolean        @default(false) @map("es_rol_principal")
  puedeSerPorDefecto   Boolean        @default(true) @map("puede_ser_por_defecto")
  accesoEfectivo       Boolean        @default(false) @map("acceso_efectivo")
  limiteDescuento      Decimal        @default(0.00) @map("limite_descuento") @db.Decimal(5, 2)
  puedeAbrirCaja       Boolean        @default(false) @map("puede_abrir_caja")
  puedeCortesParc      Boolean        @default(false) @map("puede_cortes_parciales")
  puedeCortesFinal     Boolean        @default(false) @map("puede_cortes_final")
  sucursalesPermitidas Json           @default("[]") @map("sucursales_permitidas")
  turnosPermitidos     Json           @default("[]") @map("turnos_permitidos")
  version              BigInt         @default(1)
  ultimaModificacion   DateTime       @default(now()) @map("ultima_modificacion")
  sincronizado         Boolean        @default(true)
  activo               Boolean        @default(true)
  fechaCreacion        DateTime       @default(now()) @map("fecha_creacion")
  logActividades       LogActividad[]
  permisos             Permiso[]
  sesiones             Sesion[]       @relation("RolActivo")
  usuarioRoles         UsuarioRol[]
  usuariosPorDefecto   Usuario[]      @relation("RolPorDefecto")

  @@index([prioridadOrden, activo])
  @@index([categoria, area, nivel])
  @@index([version, ultimaModificacion])
  @@map("roles")
  @@schema("rest_test")
}

model UsuarioRol {
  id                    String    @id @default(cuid()) @map("id_usuario_rol") @db.VarChar(26)
  idUsuario             String    @map("id_usuario") @db.VarChar(26)
  idRol                 String    @map("id_rol") @db.VarChar(26)
  prioridadUsuario      Int       @default(1) @map("prioridad_usuario")
  esRolPrincipal        Boolean   @default(false) @map("es_rol_principal")
  sucursalEspecifica    String?   @map("sucursal_especifica") @db.VarChar(50)
  areaEspecifica        String?   @map("area_especifica") @db.VarChar(50)
  estacionTrabajo       String?   @map("estacion_trabajo") @db.VarChar(50)
  turnosAsignados       Json      @default("[]") @map("turnos_asignados")
  idHorarioEspecifico   String?   @map("id_horario_especifico") @db.VarChar(26)
  fechaInicio           DateTime  @map("fecha_inicio") @db.Date
  fechaFin              DateTime? @map("fecha_fin") @db.Date
  limitesPersonalizados Json      @default("{}") @map("limites_personalizados")
  terminalesAsignadas   Json      @default("[]") @map("terminales_asignadas")
  version               BigInt    @default(1)
  ultimaModificacion    DateTime  @default(now()) @map("ultima_modificacion")
  sincronizado          Boolean   @default(true)
  activo                Boolean   @default(true)
  fechaAsignacion       DateTime  @default(now()) @map("fecha_asignacion")
  autorizadoPor         String?   @map("autorizado_por") @db.VarChar(26)
  autorizador           Usuario?  @relation("AutorizadoPor", fields: [autorizadoPor], references: [id])
  horarioEspecifico     Horario?  @relation("HorarioEspecifico", fields: [idHorarioEspecifico], references: [id])
  rol                   Rol       @relation(fields: [idRol], references: [id])
  usuario               Usuario   @relation(fields: [idUsuario], references: [id])

  @@index([idUsuario, prioridadUsuario, activo])
  @@index([idRol, sucursalEspecifica, activo])
  @@index([version, ultimaModificacion])
  @@map("usuario_roles")
  @@schema("rest_test")
}

model Permiso {
  id                   String       @id @default(cuid()) @map("id_permiso") @db.VarChar(26)
  idRol                String       @map("id_rol") @db.VarChar(26)
  idModuloAccion       String       @map("id_modulo_accion") @db.VarChar(26)
  permitido            Boolean      @default(true)
  limitacionMonetaria  Decimal?     @map("limitacion_monetaria") @db.Decimal(10, 2)
  limitacionHorario    Json         @default("{}") @map("limitacion_horario")
  limitacionTurno      Json         @default("{}") @map("limitacion_turno")
  limitacionSucursal   Json         @default("{}") @map("limitacion_sucursal")
  limitacionTerminal   Json         @default("{}") @map("limitacion_terminal")
  requiereAutorizacion Boolean      @default(false) @map("requiere_autorizacion")
  requiereCaja         Boolean      @default(false) @map("requiere_caja")
  requiereTurnoActivo  Boolean      @default(false) @map("requiere_turno_activo")
  version              BigInt       @default(1)
  ultimaModificacion   DateTime     @default(now()) @map("ultima_modificacion")
  sincronizado         Boolean      @default(true)
  activo               Boolean      @default(true)
  fechaCreacion        DateTime     @default(now()) @map("fecha_creacion")
  moduloAccion         ModuloAccion @relation(fields: [idModuloAccion], references: [id])
  rol                  Rol          @relation(fields: [idRol], references: [id])

  @@unique([idRol, idModuloAccion])
  @@index([permitido, activo])
  @@index([version, ultimaModificacion])
  @@map("permisos")
  @@schema("rest_test")
}

model Sesion {
  id                   String         @id @default(cuid()) @map("id_sesion") @db.VarChar(26)
  idUsuario            String         @map("id_usuario") @db.VarChar(26)
  token                String         @unique @db.VarChar(255)
  idRolActivo          String?        @map("id_rol_activo") @db.VarChar(26)
  rolesDisponibles     Json           @default("[]") @map("roles_disponibles")
  contextoActual       Json           @default("{}") @map("contexto_actual")
  sucursalActual       String?        @map("sucursal_actual") @db.VarChar(50)
  turnoActual          String?        @map("turno_actual") @db.VarChar(20)
  terminalAsignada     String?        @map("terminal_asignada") @db.VarChar(50)
  cajaAbierta          Boolean        @default(false) @map("caja_abierta")
  inicioAutomatico     Boolean        @default(true) @map("inicio_automatico")
  modoOffline          Boolean        @default(false) @map("modo_offline")
  ultimaSincronizacion DateTime?      @map("ultima_sincronizacion")
  fechaInicio          DateTime       @default(now()) @map("fecha_inicio")
  fechaExpira          DateTime?      @map("fecha_expira")
  fechaUltimaActividad DateTime       @default(now()) @map("fecha_ultima_actividad")
  activa               Boolean        @default(true)
  logActividades       LogActividad[]
  rolActivo            Rol?           @relation("RolActivo", fields: [idRolActivo], references: [id])
  usuario              Usuario        @relation(fields: [idUsuario], references: [id])

  @@index([idUsuario, activa])
  @@index([sucursalActual, turnoActual])
  @@index([modoOffline])
  @@map("sesiones")
  @@schema("rest_test")
}

model LogActividad {
  id               String       @id @default(cuid()) @map("id_actividad") @db.VarChar(26)
  idUsuario        String       @map("id_usuario") @db.VarChar(26)
  idSesion         String?      @map("id_sesion") @db.VarChar(26)
  idModuloAccion   String       @map("id_modulo_accion") @db.VarChar(26)
  descripcion      String
  idRolUtilizado   String?      @map("id_rol_utilizado") @db.VarChar(26)
  sucursal         String?      @db.VarChar(50)
  turno            String?      @db.VarChar(20)
  terminal         String?      @db.VarChar(50)
  numeroTicket     String?      @map("numero_ticket") @db.VarChar(50)
  numeroMesa       String?      @map("numero_mesa") @db.VarChar(10)
  montoTransaccion Decimal?     @map("monto_transaccion") @db.Decimal(10, 2)
  metodoPago       String?      @map("metodo_pago") @db.VarChar(30)
  resultado        String       @default("exitoso") @db.VarChar(20)
  version          BigInt       @default(1)
  sincronizado     Boolean      @default(true)
  fechaActividad   DateTime     @default(now()) @map("fecha_actividad")
  moduloAccion     ModuloAccion @relation(fields: [idModuloAccion], references: [id])
  rolUtilizado     Rol?         @relation(fields: [idRolUtilizado], references: [id])
  sesion           Sesion?      @relation(fields: [idSesion], references: [id])
  usuario          Usuario      @relation(fields: [idUsuario], references: [id])

  @@index([idUsuario, fechaActividad])
  @@index([numeroTicket, numeroMesa])
  @@index([sucursal, turno, fechaActividad])
  @@index([version, sincronizado])
  @@map("log_actividades")
  @@schema("rest_test")
}

model ColaSincronizacion {
  id                String               @id @default(cuid()) @map("id_cola") @db.VarChar(26)
  idUsuario         String?              @map("id_usuario") @db.VarChar(26)
  tipoOperacion     TipoOperacion        @map("tipo_operacion")
  tabla             String               @db.VarChar(100)
  idRegistro        String               @map("id_registro") @db.VarChar(26)
  datos             Json
  prioridad         Int                  @default(1) @db.SmallInt
  contextoOperacion Json                 @default("{}") @map("contexto_operacion")
  timestampLocal    BigInt               @map("timestamp_local")
  intentos          Int                  @default(0)
  estado            EstadoSincronizacion @default(pendiente)
  errorMessage      String?              @map("error_message")
  fechaCreacion     DateTime             @default(now()) @map("fecha_creacion")
  usuario           Usuario?             @relation(fields: [idUsuario], references: [id])

  @@index([estado, prioridad, fechaCreacion])
  @@index([tabla, idRegistro])
  @@map("cola_sincronizacion")
  @@schema("rest_test")
}

enum TipoEmpresa {
  municipal
  restaurante
  retail

  @@schema("global_sistema")
}

enum TipoHorario {
  administrativo
  operativo
  gerencial
  turno_rotativo

  @@schema("global_sistema")
}

enum AplicaTipo {
  municipal
  restaurante
  ambos

  @@schema("global_sistema")
}

enum NivelCriticidad {
  baja
  normal
  alta
  critica

  @@schema("global_sistema")
}

enum TipoOperacion {
  INSERT
  UPDATE
  DELETE

  @@schema("rest_test")
}

enum EstadoSincronizacion {
  pendiente
  procesando
  completado
  error

  @@schema("rest_test")
}
